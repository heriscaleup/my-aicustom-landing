  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #0066ff;
      --primary-dark: #0052cc;
      --primary-glow: rgba(0, 102, 255, 0.25);
      --accent-green: #10b981;
      --accent-cyan: #06b6d4;
      --accent-purple: #8b5cf6;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --bg-page: #f8fafc;
      --bg-white: #ffffff;
      --border-light: #e2e8f0;
      --border-card: rgba(226, 232, 240, 0.8);
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-card: 0 10px 30px -5px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(226, 232, 240, 0.8);
      --shadow-hover: 0 20px 40px -10px rgba(0, 102, 255, 0.15), 0 0 0 1px rgba(0, 102, 255, 0.3);
      --font-sans: 'Plus Jakarta Sans', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .font-mono { font-family: var(--font-mono); }
    .container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

    /* Sticky Glass Header */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
      transition: all 0.3s;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 72px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 800;
      font-size: 19px;
      letter-spacing: -0.02em;
    }

    .brand-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--primary), var(--accent-cyan));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 14px;
    }

    .brand-tag {
      background: rgba(0, 102, 255, 0.1);
      color: var(--primary);
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 9999px;
      margin-left: 4px;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-menu a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: color 0.2s;
    }

    .nav-menu a:hover { color: var(--primary); }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn-primary-wa {
      padding: 10px 22px;
      border-radius: 8px;
      background: var(--primary);
      color: #fff;
      font-weight: 700;
      font-size: 13px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 14px var(--primary-glow);
      transition: all 0.2s;
    }

    .btn-primary-wa:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px var(--primary-glow);
    }

    /* Hero Section (Cekat-Style) */
    .hero-section {
      position: relative;
      padding: 80px 0 60px;
      background: radial-gradient(circle at 50% 20%, rgba(0, 102, 255, 0.08) 0%, rgba(248, 250, 252, 0) 70%);
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #fff;
      border: 1px solid rgba(0, 102, 255, 0.2);
      padding: 6px 18px;
      border-radius: 9999px;
      color: var(--primary);
      font-size: 12px;
      font-weight: 700;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .badge-dot {
      width: 8px;
      height: 8px;
      background: var(--accent-green);
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 6px var(--accent-green);
    }

    .hero-title {
      font-size: clamp(34px, 5.5vw, 58px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.03em;
      max-width: 960px;
      margin: 0 auto 24px;
      color: #0f172a;
    }

    .hero-title span {
      background: linear-gradient(135deg, var(--primary) 0%, #06b6d4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      font-size: clamp(16px, 2vw, 19px);
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto 36px;
      line-height: 1.6;
    }

    .hero-cta-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-bottom: 60px;
      flex-wrap: wrap;
    }

    .btn-hero-main {
      padding: 16px 36px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      font-weight: 800;
      font-size: 16px;
      text-decoration: none;
      box-shadow: 0 8px 24px var(--primary-glow);
      transition: all 0.2s;
    }

    .btn-hero-main:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 30px var(--primary-glow);
    }

    .btn-hero-demo {
      padding: 16px 28px;
      border-radius: 10px;
      background: #fff;
      border: 1px solid var(--border-light);
      color: var(--text-main);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-hero-demo:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    /* Hero Interactive Dashboard Visual */
    .hero-dashboard-container {
      position: relative;
      max-width: 1060px;
      margin: 0 auto;
    }

    .dashboard-frame {
      background: #fff;
      border-radius: 16px;
      padding: 8px;
      box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.15), 0 0 0 1px rgba(226, 232, 240, 0.9);
      overflow: hidden;
    }

    .dashboard-img {
      width: 100%;
      height: auto;
      border-radius: 12px;
      display: block;
    }

    /* Floating Callout Badges (Cekat-Style) */
    .callout-badge {
      position: absolute;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 9999px;
      padding: 10px 18px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
      animation: float 4s ease-in-out infinite;
      z-index: 10;
    }

    .callout-top-left { top: 12%; left: -20px; animation-delay: 0s; }
    .callout-top-right { top: 8%; right: -20px; animation-delay: 1.5s; }
    .callout-bottom-left { bottom: 15%; left: -10px; animation-delay: 2.5s; }

    @media (max-width: 900px) {
      .callout-badge { display: none; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }

    /* Social Proof Bar */
    .social-proof-section {
      background: #fff;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      padding: 32px 0;
      margin-top: 60px;
    }

    .proof-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .proof-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .proof-val {
      font-size: 32px;
      font-weight: 800;
      color: var(--primary);
      line-height: 1;
    }

    .proof-desc {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 6px;
      font-weight: 600;
    }

    /* Old Way vs AI Way Comparison Section */
    .comparison-section {
      padding: 100px 0;
    }

    .section-header-center {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 60px;
    }

    .section-eyebrow {
      color: var(--primary);
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      display: block;
      margin-bottom: 8px;
    }

    .section-main-title {
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0f172a;
      line-height: 1.25;
    }

    .vs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    @media (max-width: 860px) {
      .vs-grid { grid-template-columns: 1fr; }
    }

    .vs-card {
      background: #fff;
      border-radius: 16px;
      padding: 36px 32px;
      box-shadow: var(--shadow-card);
    }

    .vs-card.old-way {
      border: 1px solid #fee2e2;
      background: #fffafa;
    }

    .vs-card.ai-way {
      border: 2px solid var(--primary);
      background: #ffffff;
      box-shadow: 0 15px 35px rgba(0, 102, 255, 0.1);
      position: relative;
    }

    .badge-vs-header {
      display: inline-block;
      font-size: 12px;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 9999px;
      margin-bottom: 16px;
    }

    .badge-vs-old { background: #fee2e2; color: #ef4444; }
    .badge-vs-ai { background: rgba(0, 102, 255, 0.1); color: var(--primary); }

    .vs-title {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 24px;
    }

    .vs-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 16px;
      font-size: 14px;
    }

    .vs-item-old {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      color: #475569;
    }

    .vs-item-old::before {
      content: "✕";
      width: 22px;
      height: 22px;
      background: #fee2e2;
      color: #ef4444;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .vs-item-ai {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      color: #0f172a;
      font-weight: 600;
    }

    .vs-item-ai::before {
      content: "✔";
      width: 22px;
      height: 22px;
      background: #d1fae5;
      color: #10b981;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
      flex-shrink: 0;
      margin-top: 2px;
    }

    /* 4 Flagship Pillars Showcase */
    .pillars-showcase-section {
      background: #ffffff;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      padding: 100px 0;
    }

    .showcase-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      margin-bottom: 100px;
    }

    .showcase-row:last-child { margin-bottom: 0; }

    @media (max-width: 900px) {
      .showcase-row { grid-template-columns: 1fr; gap: 36px; }
      .showcase-row.reversed { direction: ltr; }
    }

    .showcase-row.reversed {
      direction: rtl;
    }
    .showcase-row.reversed > * {
      direction: ltr;
    }

    .showcase-visual {
      background: #f1f5f9;
      border-radius: 16px;
      padding: 12px;
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .showcase-img {
      width: 100%;
      height: auto;
      border-radius: 10px;
      display: block;
    }

    .showcase-content h3 {
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.25;
      margin: 12px 0 16px;
    }

    .showcase-content p {
      color: var(--text-muted);
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .showcase-pills-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      font-size: 14px;
      font-weight: 600;
      color: #1e293b;
      margin-bottom: 28px;
    }

    .showcase-pills-list li {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .showcase-pills-list li::before {
      content: "✦";
      color: var(--primary);
      font-weight: 800;
    }

    /* Live WhatsApp Interactive Simulation */
    .demo-sandbox-section {
      padding: 100px 0;
      background: radial-gradient(circle at 50% 50%, rgba(0, 102, 255, 0.05) 0%, rgba(248, 250, 252, 0) 80%);
    }

    .sandbox-card {
      background: #ffffff;
      border-radius: 20px;
      border: 1px solid var(--border-light);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
    }

    @media (max-width: 900px) {
      .sandbox-card { grid-template-columns: 1fr; }
    }

    .sandbox-info {
      padding: 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .sandbox-chat {
      background: #efeae2;
      padding: 32px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      border-left: 1px solid var(--border-light);
    }

    .wa-bubble {
      max-width: 85%;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 13.5px;
      line-height: 1.5;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .wa-user {
      align-self: flex-end;
      background: #e7ffdb;
      color: #111b21;
      border-top-right-radius: 0;
    }

    .wa-ai {
      align-self: flex-start;
      background: #ffffff;
      color: #111b21;
      border-top-left-radius: 0;
    }

    /* Pricing Section */
    .pricing-section {
      padding: 100px 0;
      background: #f8fafc;
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      margin-top: 50px;
    }

    @media (max-width: 960px) {
      .pricing-grid { grid-template-columns: 1fr; }
    }

    .price-box {
      background: #fff;
      border-radius: 16px;
      padding: 40px 32px;
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .price-box.popular {
      border: 2px solid var(--primary);
      box-shadow: 0 20px 40px rgba(0, 102, 255, 0.12);
    }

    .tag-popular {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--primary);
      color: #fff;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 16px;
      border-radius: 9999px;
      letter-spacing: 0.05em;
    }

    .price-num {
      font-size: 38px;
      font-weight: 800;
      color: #0f172a;
      margin: 20px 0 6px;
    }

    .price-period {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 24px;
      font-weight: 500;
    }

    /* Footer */
    footer {
      background: #0f172a;
      color: #94a3b8;
      padding: 60px 0 30px;
      font-size: 14px;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 30px;
      margin-bottom: 30px;
      flex-wrap: wrap;
      gap: 20px;
    }

    .footer-brand {
      color: #fff;
      font-weight: 800;
      font-size: 18px;
    }
  </style>
</head>
<body>

  <!-- Sticky Glass Navbar (Cekat-Style) -->
  <header class="header">
    <div class="container nav-inner">
      <a href="/" class="brand-logo">
        <div class="brand-icon">AI</div>
        <span>my-aicustom</span>
        <span class="brand-tag">KARYAWAN AI</span>
      </a>

